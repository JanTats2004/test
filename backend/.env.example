# Ontario EV Betting Scanner — Environment Variables
# Copy this file to .env and edit as needed:
#   copy .env.example .env        (Windows CMD)
#   Copy-Item .env.example .env   (PowerShell)

# SQLite database path (default: ./ev_scanner.db)
# DATABASE_URL=sqlite:///./ev_scanner.db

# Stale odds threshold in minutes (default: 15)
# STALE_ODDS_MINUTES=15

# Default EV threshold as decimal (0.02 = +2%)
# DEFAULT_EV_THRESHOLD=0.02

# Default bankroll and stake settings
# DEFAULT_BANKROLL=1000.0
# DEFAULT_FLAT_STAKE=25.0
# DEFAULT_KELLY_FRACTION=0.25

# Stage 2: The Odds API key (https://the-odds-api.com/)
# Sign up for a free tier key. Never commit your real key.
ODDS_API_KEY=your_api_key_here
